{
  "name": "n8n-nodes-peek-pro",
  "version": "0.4.5",
  "description": "n8n community node to work with the Example API",
  "license": "MIT",
  "homepage": "https://github.com/peek-travel/n8n-nodes-peek-pro#readme",
  "keywords": [
    "n8n",
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Peek Travel Inc.",
    "email": "oskar@peek.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peek-travel/n8n-nodes-peek-pro.git"
  },
  "scripts": {
    "validate": "node scripts/validate-n8n.mjs",
    "build": "npm run validate && n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "npm run validate && npx @n8n/node-cli@latest lint && n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PeekProApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PeekPro/PeekPro.node.js",
      "dist/nodes/PeekProTrigger/PeekProTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.46.2",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "typescript": "^6.0.3"
  }
}
